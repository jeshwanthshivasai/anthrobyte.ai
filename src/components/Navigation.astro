---
interface Props {
  currentPath?: string;
  theme?: 'dark' | 'light';
}

const { currentPath = '/', theme = 'dark' } = Astro.props;

const navItems = [
  { name: 'Home', path: '/', desc: 'Structured intelligence for complex operations.' },
  { name: 'AAtlas Agents', path: '/agents', desc: 'Modular agents. One operating picture.' },
  { name: 'AI Transformation', path: '/transformation', desc: 'From pilot to operating model.' },
  { name: 'Journal', path: '/journal', desc: 'Perspective precedes implementation.' },
];
---

<header id="ab-header" class={`nav-header ${theme}`} data-theme={theme}>
  <div class="nav-container">
    <a href="/" class="brand-link" data-h="1" aria-label="Anthrobyte Home">
      <img id="header-logo-dark" src="/assets/logo-dark.svg" alt="Anthrobyte" class="brand-logo dark" />
      <img id="header-logo-light" src="/assets/logo-light.svg" alt="Anthrobyte" class="brand-logo light" />
    </a>

    <button id="menu-btn" class="menu-trigger" data-h="1" aria-label="Toggle navigation menu" aria-expanded="false">
      <span class="menu-label" data-scr="1">MENU</span>
      <span class="menu-icon">
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
      </span>
    </button>
  </div>
</header>

<div id="menu-overlay" class="menu-backdrop" aria-hidden="true">
  <div id="menu-panel" class="menu-card" role="dialog" aria-modal="true">
    <div class="menu-links">
      {navItems.map((item, idx) => (
        <a 
          href={item.path} 
          class={`menu-item ${currentPath === item.path ? 'active' : ''}`}
          data-h="1" 
          data-mrow="1"
        >
          <div class="menu-item-left">
            <span class="menu-num">0{idx + 1}</span>
            <span class="menu-name" data-scr="1">{item.name}</span>
          </div>
          <span class="menu-desc">{item.desc}</span>
        </a>
      ))}
    </div>

    <div class="menu-footer">
      <a href="mailto:hello@anthrobyte.ai" class="menu-email" data-h="1">HELLO@ANTHROBYTE.AI</a>
      <span class="menu-esc-hint">PRESS ESC TO CLOSE</span>
    </div>
  </div>
</div>

<style>
  .nav-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 80;
    padding: 24px 4vw;
    transition: background 0.3s ease;
    pointer-events: none;
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1680px;
    margin: 0 auto;
  }

  .brand-link {
    display: flex;
    align-items: center;
    pointer-events: auto;
  }

  .brand-logo {
    height: 18px;
    width: auto;
    display: block;
    transition: opacity 0.25s ease;
  }

  /* Default theme behavior */
  .nav-header.dark .brand-logo.light { display: none; }
  .nav-header.dark .brand-logo.dark { display: block; }
  .nav-header.light .brand-logo.dark { display: none; }
  .nav-header.light .brand-logo.light { display: block; }

  .menu-trigger {
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    margin: -8px -12px;
    pointer-events: auto;
    color: #f2f0eb;
    transition: color 0.25s ease;
  }

  .nav-header.light .menu-trigger {
    color: #17130f;
  }

  .menu-label {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
  }

  .menu-icon {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 18px;
    height: 12px;
  }

  .bar {
    width: 100%;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.3s cubic-bezier(0.2, 1, 0.3, 1), opacity 0.2s ease;
  }

  /* When open */
  .menu-trigger.is-open .bar-1 {
    transform: translateY(5px) rotate(45deg);
  }
  .menu-trigger.is-open .bar-2 {
    opacity: 0;
  }
  .menu-trigger.is-open .bar-3 {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* Overlay & Dropdown */
  .menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: 75;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .menu-backdrop.is-open {
    pointer-events: auto;
    opacity: 1;
  }

  .menu-card {
    position: absolute;
    top: 72px;
    right: 4vw;
    width: min(460px, 92vw);
    background: #111010;
    border: 1px solid rgba(244, 242, 238, 0.14);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.65);
    border-radius: 2px;
    opacity: 0;
    transform: translateY(-12px) scale(0.97);
    transform-origin: 100% 0;
    transition: opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1), transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .menu-backdrop.is-open .menu-card {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .menu-links {
    display: flex;
    flex-direction: column;
  }

  .menu-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    border-bottom: 1px solid rgba(244, 242, 238, 0.08);
    color: #f2f0eb;
    transition: background 0.2s ease;
  }

  .menu-item:hover, .menu-item.active {
    background: rgba(255, 96, 40, 0.08);
    color: var(--accent);
  }

  .menu-item-left {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .menu-num {
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(242, 240, 235, 0.4);
  }

  .menu-name {
    font-family: var(--sans);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .menu-desc {
    text-align: right;
    font-family: var(--serif);
    font-style: italic;
    font-size: 13px;
    color: rgba(242, 240, 235, 0.55);
    max-width: 220px;
  }

  .menu-item:hover .menu-desc {
    color: rgba(255, 96, 40, 0.9);
  }

  .menu-footer {
    border-top: 1px solid rgba(244, 242, 238, 0.12);
    padding: 14px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .menu-email {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    color: rgba(244, 242, 238, 0.5);
    transition: color 0.2s ease;
  }

  .menu-email:hover {
    color: var(--accent);
  }

  .menu-esc-hint {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    color: rgba(244, 242, 238, 0.35);
  }
</style>

<script>
  function setupMenu() {
    const btn = document.getElementById('menu-btn');
    const overlay = document.getElementById('menu-overlay');
    const panel = document.getElementById('menu-panel');

    if (!btn || !overlay || !panel) return;

    let isOpen = false;

    const toggle = (open?: boolean) => {
      isOpen = open !== undefined ? open : !isOpen;
      btn.setAttribute('aria-expanded', String(isOpen));
      btn.classList.toggle('is-open', isOpen);
      overlay.classList.toggle('is-open', isOpen);
      overlay.setAttribute('aria-hidden', String(!isOpen));
    };

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle();
    });

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        toggle(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        toggle(false);
      }
    });
  }

  setupMenu();
  document.addEventListener('astro:page-load', setupMenu);
</script>
