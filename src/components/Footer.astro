<style>
  .site-footer {
    --g: 12px;
    --fa: 0.75;
    position: relative;
    box-sizing: border-box;
    background: #0b0a09;
    color: #f2f0eb;
    margin-top: 12vh;
    padding: var(--g);
    display: flex;
    flex-direction: column;
    gap: var(--g);
    overflow: hidden;
    z-index: 10;
  }

  .footer-ascii-banner {
    position: relative;
    z-index: 1;
    min-height: 200px;
    box-sizing: border-box;
    border: 1px solid rgba(244, 242, 238, 0.13);
    background: rgba(20, 19, 17, var(--fa));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 24px 0;
  }

  .ascii-container {
    width: calc(100% - 48px);
    margin: 0 auto;
    overflow: hidden;
    display: flex;
    justify-content: center;
  }

  .ascii-wordmark {
    margin: 0;
    font-family: var(--mono);
    font-size: clamp(6px, 0.7vw, 10px);
    line-height: 1.05;
    color: var(--accent);
    white-space: pre;
    user-select: none;
  }

  .footer-grid {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--g);
  }

  .col-main {
    grid-column: span 6;
    display: flex;
    flex-direction: column;
    gap: var(--g);
  }

  .col-links {
    grid-column: span 3;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 960px) {
    .col-main { grid-column: span 12; }
    .col-links { grid-column: span 6; }
  }

  @media (max-width: 600px) {
    .col-links { grid-column: span 12; }
  }

  .card {
    box-sizing: border-box;
    border: 1px solid rgba(244, 242, 238, 0.13);
    background: rgba(20, 19, 17, var(--fa));
    padding: 24px 26px;
    display: flex;
    flex-direction: column;
  }

  .card.full-height {
    height: 100%;
  }

  .intro-card {
    gap: 20px;
  }

  .brand-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mark-icon {
    height: 22px;
    width: auto;
  }

  .brand-name {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 18px;
    color: #f2f0eb;
    letter-spacing: -0.02em;
  }

  .mission-text {
    margin: 0;
    max-width: 48ch;
    font-family: var(--serif);
    font-weight: 300;
    font-style: italic;
    font-size: 17px;
    line-height: 1.5;
    color: rgba(244, 242, 238, 0.72);
  }

  .split-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--g);
  }

  @media (max-width: 600px) {
    .split-cards { grid-template-columns: 1fr; }
  }

  .card-kicker {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.24em;
    color: var(--accent);
    margin-bottom: 20px;
  }

  .link-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.25;
    color: rgba(244, 242, 238, 0.8);
    transition: color 0.25s ease, transform 0.25s ease;
    display: inline-block;
    width: max-content;
  }

  .footer-link:hover {
    color: var(--accent);
    transform: translateX(4px);
  }

  .footer-divider {
    position: relative;
    z-index: 3;
    height: 1px;
    background: rgba(244, 242, 238, 0.18);
  }

  .footer-bottom {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--g);
  }

  @media (max-width: 768px) {
    .footer-bottom {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }

  .copyright-card {
    padding: 14px 18px;
  }

  .mono-text {
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(244, 242, 238, 0.6);
    letter-spacing: 0.22em;
  }

  .footer-mark-link {
    padding: 8px;
    line-height: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: transform 0.35s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .footer-mark-link:hover {
    transform: scale(1.14);
  }

  .center-mark {
    height: 26px;
    width: auto;
  }

  .next-card {
    padding: 14px 18px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  @media (max-width: 768px) {
    .next-card { align-items: center; }
  }

  .progress-track {
    width: min(200px, 100%);
    height: 2px;
    background: rgba(244, 242, 238, 0.15);
  }

  .progress-fill {
    width: 0%;
    height: 100%;
    background: var(--accent);
    transition: width 0.1s linear;
  }
</style>

<script>
  function setupNextScroller() {
    const nextCard = document.querySelector('.next-card');
    const fill = document.getElementById('footer-next-fill');
    if (!nextCard || !fill) return;

    const targetUrl = nextCard.getAttribute('data-next-url');
    if (!targetUrl) return;

    let progress = 0;
    let wheelAccum = 0;

    const onWheel = (e: WheelEvent) => {
      // Check if user is scrolled to bottom
      const atBottom = window.innerHeight + window.scrollY >= document.body.offsetHeight - 50;
      if (atBottom && e.deltaY > 0) {
        wheelAccum += e.deltaY * 0.08;
        progress = Math.min(100, Math.max(0, wheelAccum));
        fill.style.width = `${progress}%`;

        if (progress >= 100) {
          window.removeEventListener('wheel', onWheel);
          window.location.href = targetUrl;
        }
      } else if (wheelAccum > 0) {
        wheelAccum = Math.max(0, wheelAccum - 10);
        progress = wheelAccum;
        fill.style.width = `${progress}%`;
      }
    };

    window.addEventListener('wheel', onWheel, { passive: true });
  }

  setupNextScroller();
  document.addEventListener('astro:page-load', setupNextScroller);
</script>
